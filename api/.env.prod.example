# 生产环境变量。复制成 .env.prod 填好，放在服务器上，不要提交。
#   cp .env.prod.example .env.prod

# --- 模型 ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_LLM_MODEL=deepseek/deepseek-v3.2

# --- MongoDB Atlas 云 ---
# 从 Atlas 控制台 Connect -> Drivers 复制，注意：
#   1. 密码里的特殊字符要 URL 编码（@ -> %40，# -> %23）
#   2. 末尾补上数据库名，否则 langchain-mongodb 有些路径会落到 test 库
#   3. Atlas 的 Network Access 要加这台 VPS 的出口 IP，不要图省事填 0.0.0.0/0
MONGO_URI=mongodb+srv://用户名:密码@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=three_kingdoms

# --- 部署 ---
# 前端的实际域名，逗号分隔可以填多个（比如 Pages 的预览域名）。
# 必须填。留空会回落到 localhost 白名单，线上前端就连不上了。
ALLOWED_ORIGINS=https://threekingdoms.zongzheng.dev

# /reset-memory 的口令。不填 = 该接口 404（推荐）。
# 要用就生成一个长的：openssl rand -hex 32
# ADMIN_TOKEN=

# --- 可选：Opik 追踪 ---
# 线上要不要开追踪自己定。开了每轮对话都会往 Comet 发数据，
# 好处是线上真实对话能回看，坏处是多一个外部依赖和一点延迟。
# COMET_API_KEY=
# COMET_PROJECT=three-kingdoms-agent
